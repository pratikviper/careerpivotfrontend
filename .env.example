# Leave unset so the browser calls this app and Next forwards /api/* to the backend.
# Set an absolute URL only when the browser should call the API directly (CORS required).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side only. Where Next.js proxies /api/* .
API_PROXY_TARGET=http://127.0.0.1:8000
